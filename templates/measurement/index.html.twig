{% extends 'base.html.twig' %}

{% block title %}Measurements{% endblock %}

{% block body %}
    <h1>Measurements</h1>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Temperature</th>
                <th>Location</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for measurement in measurements %}
                <tr>
                    <td>{{ measurement.id }}</td>
                    <td>
                        {{ measurement.date ? measurement.date|date('d.m.Y') : '' }}
                    </td>
                    <td>{{ measurement.celsius }} °C</td>
                    <td>{{ measurement.location.city }}</td>
                    <td>
                        {% if is_granted('ROLE_MEASUREMENT_SHOW') %}
                            <a class="btn btn-sm btn-info"
                               href="{{ path('app_measurement_show', {'id': measurement.id}) }}">
                                Show
                            </a>
                        {% endif %}

                        {% if is_granted('ROLE_MEASUREMENT_EDIT') %}
                            <a class="btn btn-sm btn-warning"
                               href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">
                                Edit
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No measurements found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if is_granted('ROLE_MEASUREMENT_NEW') %}
        <a class="btn btn-primary"
           href="{{ path('app_measurement_new') }}">
            Create new
        </a>
    {% endif %}
{% endblock %}
