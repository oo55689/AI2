{% extends 'base.html.twig' %}

{% block title %}Locations{% endblock %}

{% block body %}
    <h1>Locations</h1>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
            <tr>
                <th>Id</th>
                <th>City</th>
                <th>Country</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for location in locations %}
                <tr>
                    <td>{{ location.id }}</td>
                    <td>{{ location.city }}</td>
                    <td>{{ location.country }}</td>
                    <td>{{ location.latitude }}</td>
                    <td>{{ location.longitude }}</td>
                    <td>
                        {% if is_granted('ROLE_LOCATION_SHOW') %}
                            <a class="btn btn-sm btn-info"
                               href="{{ path('app_location_show', {'id': location.id}) }}">
                                Show
                            </a>
                        {% endif %}

                        {% if is_granted('ROLE_LOCATION_EDIT') %}
                            <a class="btn btn-sm btn-warning"
                               href="{{ path('app_location_edit', {'id': location.id}) }}">
                                Edit
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">No locations found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if is_granted('ROLE_LOCATION_NEW') %}
        <a class="btn btn-primary"
           href="{{ path('app_location_new') }}">
            Create new
        </a>
    {% endif %}
{% endblock %}
