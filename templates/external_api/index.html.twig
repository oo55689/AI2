{% extends 'base.html.twig' %}

{% block title %}External API{% endblock %}

{% block body %}
    <h1>Weather Forecast - Open-Meteo</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}

    <button type="submit" class="btn btn-primary mt-3">
        Get Forecast
    </button>
    {{ form_end(form) }}

    {% if error %}
        <div class="alert alert-danger mt-3">
            {{ error }}
        </div>
    {% endif %}

    {% if weatherData is not null and weatherData.daily is defined %}
        <h2 class="mt-4">Weather Forecast</h2>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                <tr>
                    <th>Date</th>
                    <th>Min Temperature (°C)</th>
                    <th>Max Temperature (°C)</th>
                    <th>Precipitation (mm)</th>
                </tr>
                </thead>
                <tbody>
                {% for date in weatherData.daily.time %}
                    <tr>
                        <td>{{ date }}</td>

                        <td>
                            {{ weatherData.daily.temperature_2m_min[loop.index0] }}
                        </td>

                        <td>
                            {{ weatherData.daily.temperature_2m_max[loop.index0] }}
                        </td>

                        <td>
                            {{ weatherData.daily.precipitation_sum[loop.index0] }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
