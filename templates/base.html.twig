<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Pogodynka{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=55689");
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>
<nav class="navbar navbar-expand-lg bg-light border-bottom">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_location_index') }}">
            Pogodynka
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarMenu"
                aria-controls="navbarMenu"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">
            <div class="navbar-nav">
                <a class="nav-link" href="{{ path('app_location_index') }}">
                    Locations
                </a>
                <a class="nav-link" href="{{ path('app_measurement_index') }}">
                    Measurements
                </a>
            </div>
        </div>
    </div>
</nav>

<main class="container bg-white p-4 mt-4 rounded shadow-sm">
    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>
